[Unit]
Description=Load mcxTemplate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=90s
ExecStart=/usr/lib/{{ PRODUCT_ID }}/load-mcxtemplate


[Install]
WantedBy=multi-user.target
