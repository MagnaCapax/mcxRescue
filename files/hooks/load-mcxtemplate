#!/bin/sh

# SPDX-PackageSummary: mcxRescue-live-build
# SPDX-FileComment: mcxRescue Template Engine Loader
# SPDX-FileCopyrightText: Copyright (C) 2025 Magna Capax Finland Oy
# SPDX-License-Identifier: MPL-2.0

# Purpose:
# - Idempotently ensure the mcxRescue template engine repository exists under /opt
# - If present, update it with a fast-forward pull; if missing, perform a shallow clone
set -eu

# Ensure /opt exists and change into it safely
if [ ! -d /opt ]; then
    mkdir -p /opt
fi
cd /opt || exit 1

if command -v systemctl >/dev/null 2>&1; then
    systemctl is-system-running --wait >/dev/null 2>&1 || true
fi

if ! command -v git >/dev/null 2>&1; then
    echo "load-mcxtemplate: 'git' not found in PATH; cannot fetch mcxRescue" >&2
    exit 1
fi

export GIT_TERMINAL_PROMPT=0

REPO_URL="${MCXTEMPLATE_REPO_URL:-https://github.com/MagnaCapax/mcxRescue}"
REPO_DIR="${MCXTEMPLATE_DIR:-mcxRescue}"
RETRIES="${MCXTEMPLATE_RETRIES:-5}"
RETRY_DELAY="${MCXTEMPLATE_RETRY_DELAY:-5}"

retry_git() {
    retries="$1"
    delay="$2"
    shift 2

    attempt=1
    while [ "$attempt" -le "$retries" ]; do
        if "$@"; then
            return 0
        fi
        echo "load-mcxtemplate: git attempt ${attempt}/${retries} failed; retrying in ${delay}s" >&2
        sleep "$delay" || break
        attempt=$((attempt + 1))
    done
    return 1
}

# Idempotent fetch/update
if [ -d "${REPO_DIR}/.git" ]; then
    if ! retry_git "$RETRIES" "$RETRY_DELAY" git -C "${REPO_DIR}" pull --ff-only --quiet; then
        echo "load-mcxtemplate: git pull failed after retries; leaving existing checkout" >&2
    fi
else
    if ! retry_git "$RETRIES" "$RETRY_DELAY" git clone --depth=1 --quiet "${REPO_URL}" "${REPO_DIR}"; then
        echo "load-mcxtemplate: clone failed after retries" >&2
        exit 1
    fi
fi

echo "load-mcxtemplate: repository ready at /opt/${REPO_DIR}" >&2
