#!/bin/sh

# SPDX-PackageSummary: mcxRescue-live-build
# SPDX-FileComment: Execute mcxCommand from kernel cmdline (download + run)
# SPDX-FileCopyrightText: Copyright (C) 2025 Magna Capax Finland Oy
# SPDX-License-Identifier: MPL-2.0

set -eu

# Extract mcxCommand URL and the optional mcxSha256 pin (ADR 0004) from kernel cmdline
MCX_COMMAND=""
MCX_SHA256=""
if [ -r /proc/cmdline ]; then
    # /proc/cmdline is a single whitespace-separated line; iterate by word.
    # shellcheck disable=SC2013
    for w in $(cat /proc/cmdline); do
        case "$w" in
            mcxCommand=*) MCX_COMMAND=${w#mcxCommand=};;
            mcxSha256=*) MCX_SHA256=${w#mcxSha256=};;
        esac
    done
fi

[ -n "$MCX_COMMAND" ] || exit 0

# Logs carry the URL without its query string, which may hold job data.
MCX_COMMAND_LOG=${MCX_COMMAND%%\?*}

# A pin that is present must be well formed; a malformed pin never runs the script.
if [ -n "$MCX_SHA256" ]; then
    MCX_SHA256=$(printf '%s' "$MCX_SHA256" | tr 'A-F' 'a-f')
    case "$MCX_SHA256" in
        *[!0-9a-f]*) echo "mcxCommand: mcxSha256 is not hex; not running" >&2; exit 1;;
    esac
    if [ "${#MCX_SHA256}" -ne 64 ]; then
        echo "mcxCommand: mcxSha256 is not 64 hex digits; not running" >&2
        exit 1
    fi
fi

# Minimal context for convenience (best-effort)
MCX_PRODUCT_ID="{{ PRODUCT_ID }}"
MCX_HOSTNAME="$(hostname -s 2>/dev/null || echo mcxrescue)"
MCX_ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
export MCX_COMMAND MCX_PRODUCT_ID MCX_HOSTNAME MCX_ARCH

# Best-effort network details
IF_ROUTE_INFO="$(ip route get 1.1.1.1 2>/dev/null || true)"
MCX_IFACE="$(printf '%s\n' "$IF_ROUTE_INFO" | awk '/ dev / {for(i=1;i<=NF;i++){if($i=="dev"){print $(i+1); exit}}}')"
MCX_IP4="$(printf '%s\n' "$IF_ROUTE_INFO" | awk '/ src / {for(i=1;i<=NF;i++){if($i=="src"){print $(i+1); exit}}}')"
if [ -n "$MCX_IFACE" ]; then
    export MCX_IFACE
fi
if [ -n "$MCX_IP4" ]; then
    export MCX_IP4
fi

# DHCP server (best-effort)
get_dhcp_server() {
    # systemd-networkd leases
    if [ -d /run/systemd/netif/leases ]; then
        if awk -F= '/^SERVER_ADDRESS=/{print $2; found=1; exit} END{if(!found) exit 1}' /run/systemd/netif/leases/* 2>/dev/null; then
            return 0
        fi
    fi
    # dhclient leases
    if awk '/dhcp-server-identifier/ {gsub(";","",$3); print $3; found=1; exit} END{if(!found) exit 1}' /var/lib/dhcp/dhclient*.leases 2>/dev/null; then
        return 0
    fi
    return 1
}
if DHCP_SRV="$(get_dhcp_server 2>/dev/null)" && [ -n "$DHCP_SRV" ]; then
    export MCX_DHCP_SERVER="$DHCP_SRV"
fi

# Best-effort: wait until system reports 'running' (approximate "last" at boot)
if command -v systemctl >/dev/null 2>&1; then
    systemctl is-system-running --wait >/dev/null 2>&1 || true
fi

echo "mcxCommand: start url=$MCX_COMMAND_LOG host=$MCX_HOSTNAME pinned=$([ -n "$MCX_SHA256" ] && echo yes || echo no)" >&2

tmp="/run/mcxCommand.$$.sh"
rm -f "$tmp"
if ! wget -q --no-check-certificate -O "$tmp" "$MCX_COMMAND"; then
    echo "mcxCommand: download failed url=$MCX_COMMAND_LOG" >&2
    rm -f "$tmp"
    exit 1
fi

if [ -n "$MCX_SHA256" ]; then
    got=$(sha256sum "$tmp" | awk '{print $1}')
    if [ "$got" != "$MCX_SHA256" ]; then
        echo "mcxCommand: sha256 mismatch url=$MCX_COMMAND_LOG; not running" >&2
        rm -f "$tmp"
        exit 1
    fi
fi
chmod +x "$tmp" || true

bash "$tmp" || rc=$?
rc=${rc:-0}
rm -f "$tmp" || true

echo "mcxCommand: done rc=$rc" >&2
exit "$rc"
