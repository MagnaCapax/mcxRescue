[Unit]
Description=Load mcxForge
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=90s
ExecStart=/usr/lib/{{ PRODUCT_ID }}/load-mcxforge

[Install]
WantedBy=multi-user.target
