__sh_exitcode() { ret=$?; if [[ $ret != 0 ]]; then echo "$ret "; fi }

if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[1;31m\]$(__sh_exitcode)\[\033[1;37m\]\u\[\033[0;39m\]@\[\033[1;37m\]\h(\l)\[\033[0;39m\]:\[\033[1;37m\]\w\[\033[1;34m\]\$\[\033[0;39m\] '
else
    PS1='${debian_chroot:+($debian_chroot)}$(__sh_exitcode)\u@\h:\w\$ '
fi

export GPG_TTY="$(tty)"

if [ -x "/usr/lib/{{ PRODUCT_ID }}/ssh-agent" ]; then
    . "/usr/lib/{{ PRODUCT_ID }}/ssh-agent"
fi

alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alF'

alias httpd='python3 -m http.server'

# Benchmarks & Diagnostics (convenience)
# YABS: Yet Another Bench Script (fetch and run)
alias yabs='wget -qO- yabs.sh | bash'

# Geekbench helper: download static Geekbench 6 tarball if missing, then run
# Usage: geekbench [version]
# Defaults to 6.5.0 unless overridden by GEEKBENCH_VER / GEEKBENCH_URL
geekbench() {
    local ver
    ver=${1:-${GEEKBENCH_VER:-6.5.0}}
    local url
    url=${GEEKBENCH_URL:-"https://cdn.geekbench.com/Geekbench-${ver}-Linux.tar.gz"}
    local base="/opt/Geekbench-${ver}-Linux"
    local tarball="/tmp/Geekbench-${ver}-Linux.tar.gz"

    mkdir -p /opt || true
    if [ ! -x "${base}/geekbench6" ] && [ ! -x "${base}/geekbench_x86_64" ]; then
        echo "[geekbench] fetching ${url} -> ${tarball}"
        wget -q -O "${tarball}" "${url}" || { echo "[geekbench] download failed" >&2; return 1; }
        echo "[geekbench] extracting to ${base}"
        rm -rf "${base}"
        tar -C /opt -xzf "${tarball}" || { echo "[geekbench] extract failed" >&2; return 1; }
    fi

    if [ -x "${base}/geekbench6" ]; then
        "${base}/geekbench6"
    elif [ -x "${base}/geekbench_x86_64" ]; then
        "${base}/geekbench_x86_64"
    else
        # Try a best-effort fallback
        local bin
        bin=$(find "${base}" -maxdepth 1 -type f -perm -111 -name 'geekbench*' | head -n1 || true)
        if [ -n "${bin}" ]; then
            "${bin}"
        else
            echo "[geekbench] executable not found in ${base}" >&2
            return 1
        fi
    fi
}

# mcxForge tools on PATH for convenience
if [ -d /opt/mcxForge/bin ]; then
    export PATH="/opt/mcxForge/bin:${PATH}"
fi
