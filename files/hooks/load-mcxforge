#!/bin/sh

# SPDX-PackageSummary: mcxRescue-live-build
# SPDX-FileComment: mcxForge Repository Loader
# SPDX-FileCopyrightText: Copyright (C) 2025 Magna Capax Finland Oy
# SPDX-License-Identifier: MPL-2.0

# Idempotently ensure /opt/mcxForge exists and is up-to-date.
# Fetches from GitHub using shallow clone; updates via ff-only pull.

set -eu

# Ensure /opt exists
mkdir -p /opt

# Non-interactive git
export GIT_TERMINAL_PROMPT=0

REPO_URL="${MCXFORGE_REPO_URL:-https://github.com/MagnaCapax/mcxForge}"
REPO_DIR="/opt/mcxForge"

echo "load-mcxforge: preparing ${REPO_DIR} from ${REPO_URL}" >&2

if command -v git >/dev/null 2>&1; then
    if [ -d "${REPO_DIR}/.git" ]; then
        git -C "${REPO_DIR}" pull --ff-only --quiet || {
            echo "load-mcxforge: git pull failed; leaving existing checkout" >&2
        }
    else
        rm -rf "${REPO_DIR}" || true
        git clone --depth=1 --quiet "${REPO_URL}" "${REPO_DIR}" || {
            echo "load-mcxforge: clone failed" >&2
            exit 1
        }
    fi
else
    echo "load-mcxforge: 'git' not found; cannot fetch mcxForge" >&2
    exit 1
fi

echo "load-mcxforge: repository ready at ${REPO_DIR}" >&2

