[Unit]
Description=Execute mcxCommand from kernel cmdline
ConditionKernelCommandLine=|mcxCommand

[Service]
Type=oneshot
ExecStart=/usr/lib/{{ PRODUCT_ID }}/mcxCommand

[Install]
WantedBy=multi-user.target

