#!/bin/bash

# SPDX-PackageSummary: mcxRescue-live-build
# SPDX-FileComment: mcxCommand installer chroot hook
# SPDX-FileCopyrightText: Copyright (C) 2025 Magna Capax Finland Oy
# SPDX-License-Identifier: MPL-2.0

set -e

PRODUCT_ID="{{ PRODUCT_ID }}"

install -D -m 0755 /hook-files/mcxCommand "/usr/lib/${PRODUCT_ID}/mcxCommand"
install -D -m 0644 /hook-files/mcxCommand.service /etc/systemd/system/mcxCommand.service
systemctl add-wants multi-user.target mcxCommand.service
